#!/usr/bin/env bash
# Retro HUD Floating Widget

clear
fastfetch -c ~/.config/fastfetch/retro.jsonc

echo -e "\n\033[1;35m[ TELEMETRY MONITOR ]\033[0m Press \033[1;36m[q]\033[0m or \033[1;36m[Esc]\033[0m to close, \033[1;33m[b]\033[0m for BTop"
echo -e "\033[0;32m"
echo "  CPU FREQ : $(cat /proc/cpuinfo | grep 'cpu MHz' | head -n 1 | awk '{print $4}') MHz"
echo "  CORES    : $(nproc) THREADS ONLINE"
echo "  LOAD AVG : $(cat /proc/loadavg | awk '{print $1, $2, $3}')"
echo "  DISKS    : $(df -h / | awk 'NR==2 {print $3 "/" $2 " (" $5 " used)"}')"
echo -e "\033[0m"

read -rsn1 -p " > COMMAND: " key
if [ "$key" = "b" ]; then
    command -v btop >/dev/null && exec btop
fi
