#!/usr/bin/env bash
# Retro Universal Search tool powered by Wofi

export LD_LIBRARY_PATH="/home/gopal/.local/lib:${LD_LIBRARY_PATH:-}"
export PATH="/home/gopal/.local/bin:${PATH:-}"

QUERY=$(wofi --dmenu --prompt "▶ RETRO_SEARCH (Type query or prefix >:Web, ~:File, =:Math):" --width 700 --height 350)

# If canceled, exit
[ -z "$QUERY" ] && exit 0

# Web search prefix: >
if [[ "$QUERY" == \>* ]]; then
    TERM_SEARCH="${QUERY#>}"
    TERM_ENCODED=$(python3 -c "import urllib.parse, sys; print(urllib.parse.quote(sys.argv[1].strip()))" "$TERM_SEARCH")
    xdg-open "https://duckduckgo.com/?q=${TERM_ENCODED}" &
    exit 0
fi

# Calculator prefix: =
if [[ "$QUERY" == =* ]]; then
    EXPR="${QUERY#=}"
    RESULT=$(python3 -c "import math; print(eval('''$EXPR'''))" 2>/dev/null || echo "Math Error")
    notify-send "Retro Calc" "$EXPR = $RESULT"
    echo "$RESULT" | wl-copy 2>/dev/null || true
    exit 0
fi

# File search prefix: ~
if [[ "$QUERY" == \~* ]]; then
    SEARCH_PATTERN="${QUERY#~}"
    SEARCH_PATTERN=$(echo "$SEARCH_PATTERN" | xargs)
    FILE_FOUND=$(find "$HOME" -maxdepth 4 -iname "*${SEARCH_PATTERN}*" 2>/dev/null | head -n 40 | wofi --dmenu --prompt "▶ OPEN_FILE:")
    if [ -n "$FILE_FOUND" ] && [ -e "$FILE_FOUND" ]; then
        xdg-open "$FILE_FOUND" &
    fi
    exit 0
fi

# Default: try to execute command or web search fallback
if command -v "$QUERY" >/dev/null 2>&1; then
    nohup "$QUERY" >/dev/null 2>&1 &
else
    # Check if desktop application matches
    APP_EXEC=$(grep -rli "Name=.*$QUERY" /usr/share/applications ~/.local/share/applications 2>/dev/null | head -n 1)
    if [ -n "$APP_EXEC" ]; then
        gtk-launch "$(basename "$APP_EXEC" .desktop)" &
    else
        # Fallback to web search
        TERM_ENCODED=$(python3 -c "import urllib.parse, sys; print(urllib.parse.quote(sys.argv[1].strip()))" "$QUERY")
        xdg-open "https://duckduckgo.com/?q=${TERM_ENCODED}" &
    fi
fi
