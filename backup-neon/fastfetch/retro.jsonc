{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "small",
        "padding": {
            "top": 1,
            "left": 2
        }
    },
    "display": {
        "separator": " ⚡ "
    },
    "modules": [
        {
            "type": "custom",
            "format": " \u001b[38;2;255;42;133m╔═══════════════════════════════════════════════════╗\u001b[0m"
        },
        {
            "type": "custom",
            "format": " \u001b[38;2;0;243;255m║         🕹️  RETRO-OS MAINFRAME // 198X-2026        ║\u001b[0m"
        },
        {
            "type": "custom",
            "format": " \u001b[38;2;255;42;133m╚═══════════════════════════════════════════════════╝\u001b[0m"
        },
        "break",
        {
            "type": "os",
            "key": "  SYS",
            "keyColor": "cyan"
        },
        {
            "type": "kernel",
            "key": "  KRNL",
            "keyColor": "cyan"
        },
        {
            "type": "wm",
            "key": "  COMP",
            "keyColor": "magenta"
        },
        {
            "type": "shell",
            "key": "  SHLL",
            "keyColor": "magenta"
        },
        {
            "type": "terminal",
            "key": "  TERM",
            "keyColor": "green"
        },
        {
            "type": "cpu",
            "key": "  PROC",
            "keyColor": "yellow"
        },
        {
            "type": "gpu",
            "key": "  VPU ",
            "keyColor": "yellow"
        },
        {
            "type": "memory",
            "key": "  MEM ",
            "keyColor": "blue"
        },
        {
            "type": "uptime",
            "key": "  UPTM",
            "keyColor": "blue"
        },
        "break",
        {
            "type": "colors",
            "symbol": "square",
            "block": {
                "range": [0, 15],
                "width": 3
            }
        }
    ]
}
