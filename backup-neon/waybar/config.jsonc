{
    "layer": "top",
    "position": "top",
    "height": 38,
    "spacing": 8,
    "margin-top": 6,
    "margin-left": 12,
    "margin-right": 12,

    "modules-left": [
        "custom/retro_logo",
        "custom/retro_search",
        "hyprland/workspaces"
    ],
    "modules-center": [
        "hyprland/window"
    ],
    "modules-right": [
        "cpu",
        "memory",
        "pulseaudio",
        "battery",
        "clock",
        "custom/retro_widget",
        "custom/power"
    ],

    "custom/retro_logo": {
        "format": "🕹️ RETRO_OS",
        "on-click": "wofi --show drun",
        "tooltip-format": "Retro Application Launcher (Click or Super+R)"
    },

    "custom/retro_search": {
        "format": "🔍 SEARCH",
        "on-click": "/home/gopal/.local/bin/retro-search",
        "tooltip-format": "Retro Universal Search (Click or Super+S)"
    },

    "hyprland/workspaces": {
        "disable-scroll": false,
        "all-outputs": true,
        "active-only": false,
        "on-click": "activate",
        "format": "[{id}:{name}]",
        "format-icons": {
            "1": "SYS",
            "2": "DEV",
            "3": "WEB",
            "4": "CHAT",
            "5": "GAME",
            "6": "MEDIA",
            "7": "WORK",
            "8": "DOCS",
            "9": "MISC",
            "10": "AUX"
        }
    },

    "hyprland/window": {
        "format": "▶ {title}",
        "max-length": 50,
        "separate-outputs": true
    },

    "cpu": {
        "interval": 2,
        "format": "CPU: {usage:2}%",
        "tooltip": true
    },

    "memory": {
        "interval": 3,
        "format": "RAM: {used:0.1f}G",
        "tooltip-format": "Memory: {used:0.2f}GiB / {total:0.2f}GiB ({percentage}%)"
    },

    "pulseaudio": {
        "format": "VOL: {volume}%",
        "format-muted": "VOL: MUTED",
        "on-click": "pavucontrol",
        "scroll-step": 5
    },

    "battery": {
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "PWR: {capacity}%",
        "format-charging": "CHR: {capacity}%",
        "format-plugged": "AC: {capacity}%",
        "tooltip-format": "{timeTo}, {capacity}%"
    },

    "clock": {
        "interval": 1,
        "format": "{:%H:%M:%S  %Y-%m-%d}",
        "tooltip-format": "<tt><small>{calendar}</small></tt>",
        "calendar": {
            "mode": "month",
            "mode-mon-col": 3,
            "weeks-pos": "right",
            "on-scroll": 1,
            "format": {
                "months": "<span color='#ff2a85'><b>{}</b></span>",
                "days": "<span color='#f1ebf9'><b>{}</b></span>",
                "weeks": "<span color='#00f3ff'><b>W{}</b></span>",
                "weekdays": "<span color='#ffe600'><b>{}</b></span>",
                "today": "<span color='#05ffa1'><b><u>{}</u></b></span>"
            }
        }
    },

    "custom/retro_widget": {
        "format": "👾 HUD",
        "on-click": "/home/gopal/.local/bin/retro-hud-toggle",
        "tooltip-format": "Toggle Retro Telemetry HUD (Click or Super+W)"
    },

    "custom/power": {
        "format": "⚡ EXIT",
        "on-click": "wlogout -b 2",
        "tooltip-format": "Retro System Power Menu (Click or Super+X)"
    }
}
