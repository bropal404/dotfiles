{
    "layer": "top",
    "position": "top",
    "height": 34,
    "spacing": 0,
    "margin-top": 6,
    "margin-left": 10,
    "margin-right": 10,

    "modules-left": [
        "custom/retro_logo",
        "custom/cursor",
        "hyprland/workspaces",
        "custom/retro_search"
    ],
    "modules-center": [
        "hyprland/window"
    ],
    "modules-right": [
        "cpu",
        "memory",
        "pulseaudio",
        "battery",
        "clock",
        "custom/power"
    ],

    "custom/retro_logo": {
        "format": "░▒▓ RUN",
        "on-click": "/home/gopal/.config/rofi/launch apps",
        "tooltip-format": "Launcher  (Super+R)"
    },

    "custom/cursor": {
        "format": "█",
        "tooltip": false
    },

    "custom/retro_search": {
        "format": "◎ FIND",
        "on-click": "/home/gopal/.config/rofi/launch find",
        "tooltip-format": "Find apps, commands, windows, files  (Super+S)\nTab switches mode"
    },

    "hyprland/workspaces": {
        "disable-scroll": false,
        "all-outputs": true,
        "on-click": "activate",
        "format": "{id}"
    },

    "hyprland/window": {
        "format": "▸ {title}",
        "max-length": 50,
        "separate-outputs": true
    },

    "cpu": {
        "interval": 2,
        "format": "CPU {icon} {usage:>2}%",
        "format-icons": ["▁", "▂", "▃", "▄", "▅", "▆", "▇", "█"]
    },

    "memory": {
        "interval": 3,
        "format": "MEM {icon} {used:0.1f}G",
        "format-icons": ["▁", "▂", "▃", "▄", "▅", "▆", "▇", "█"],
        "tooltip-format": "{used:0.2f} / {total:0.2f} GiB  ({percentage}%)"
    },

    "pulseaudio": {
        "format": "VOL {volume}%",
        "format-muted": "VOL ──",
        "on-click": "pavucontrol",
        "scroll-step": 5
    },

    "battery": {
        "states": { "warning": 30, "critical": 15 },
        "format": "{icon} {capacity}%",
        "format-charging": "▲ {capacity}%",
        "format-plugged": "■ {capacity}%",
        "format-icons": ["░░░░", "█░░░", "██░░", "███░", "████"],
        "tooltip-format": "{timeTo}, {capacity}%"
    },

    "clock": {
        "interval": 30,
        "format": "{:%a %d %b  %H:%M}",
        "tooltip-format": "<tt><small>{calendar}</small></tt>",
        "calendar": {
            "mode": "month",
            "weeks-pos": "",
            "on-scroll": 1,
            "format": {
                "months":   "<span color='#e08a2e'><b>{}</b></span>",
                "days":     "<span color='#e6d5b0'>{}</span>",
                "weekdays": "<span color='#9a8a6e'>{}</span>",
                "today":    "<span background='#e08a2e' color='#1b1814'><b>{}</b></span>"
            }
        }
    },

    "custom/power": {
        "format": "⏻",
        "on-click": "wlogout -b 5",
        "tooltip-format": "Power  (Super+X)"
    }
}
