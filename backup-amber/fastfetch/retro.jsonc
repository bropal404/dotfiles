{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "small",
        "color": { "1": "38;2;224;138;46", "2": "38;2;217;178;74" },
        "padding": { "top": 1, "left": 2 }
    },
    "display": {
        "separator": "  ",
        "color": { "keys": "38;2;224;138;46", "output": "38;2;230;213;176" }
    },
    "modules": [
        { "type": "custom", "format": "\u001b[38;2;224;138;46m┌──────────────────────────────────────┐\u001b[0m" },
        { "type": "custom", "format": "\u001b[38;2;224;138;46m│\u001b[38;2;230;213;176m ░▒▓ SYSTEM REPORT               ▓▒░ \u001b[38;2;224;138;46m│\u001b[0m" },
        { "type": "custom", "format": "\u001b[38;2;224;138;46m└──────────────────────────────────────┘\u001b[0m" },
        "break",
        { "type": "os",       "key": " OS    " },
        { "type": "kernel",   "key": " KERNEL" },
        { "type": "wm",       "key": " WM    " },
        { "type": "shell",    "key": " SHELL " },
        { "type": "terminal", "key": " TERM  " },
        { "type": "cpu",      "key": " CPU   " },
        { "type": "gpu",      "key": " GPU   " },
        { "type": "memory",   "key": " MEMORY" },
        { "type": "uptime",   "key": " UPTIME" },
        "break",
        { "type": "colors", "symbol": "block", "block": { "range": [0, 15], "width": 3 } }
    ]
}
