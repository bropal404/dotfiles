* {
    bg:       #1b1814;
    surface:  #262019;
    edge:     #4a3f31;
    fg:       #e6d5b0;
    dim:      #9a8a6e;
    amber:    #e08a2e;
    rust:     #c0552b;

    background-color: transparent;
    text-color:       @fg;
    margin:  0;
    padding: 0;
    spacing: 0;
}

window {
    width:            640px;
    background-color: @bg;
    border:           2px;
    border-color:     @amber;
    border-radius:    0;
}

mainbox {
    children: [ inputbar, mode-switcher, listview ];
}

inputbar {
    background-color: @surface;
    padding:          10px 14px;
    border:           0 0 2px 0;
    border-color:     @edge;
    children:         [ prompt, entry ];
    spacing:          10px;
}
prompt { text-color: @amber; }
entry  {
    text-color:        @amber;
    placeholder:       "type to search_";
    placeholder-color: @dim;
    cursor:            text;
}

mode-switcher {
    background-color: @bg;
    border:           0 0 1px 0;
    border-color:     @edge;
}
button {
    padding:    4px 0;
    text-color: @dim;
}
button selected {
    background-color: @surface;
    text-color:       @amber;
}

listview {
    lines:        9;
    columns:      1;
    fixed-height: true;
    scrollbar:    false;
    padding:      8px;
}

element {
    padding: 3px 10px;
    spacing: 10px;
}
element-icon { size: 22px; }
element-text { text-color: inherit; vertical-align: 0.5; }

element normal.normal,
element alternate.normal { text-color: @fg; }
element selected.normal  { background-color: @amber; text-color: @bg; }
element normal.urgent,
element alternate.urgent { text-color: @rust; }
element selected.urgent  { background-color: @rust; text-color: @bg; }
element normal.active,
element alternate.active { text-color: @amber; }
element selected.active  { background-color: @amber; text-color: @bg; }

message { padding: 8px 14px; border: 1px 0 0 0; border-color: @edge; }
textbox { text-color: @dim; }
