/* 1995-style rofi: Start menu + Run/Find dialog */
configuration {
    modi:                "drun,run,window,filebrowser";
    show-icons:          true;
    icon-theme:          "Colloid-Light";
    font:                "Liberation Sans 11";
    terminal:            "kitty";
    drun-display-format: "{name}";
    display-drun:        "Programs";
    display-run:         "Run";
    display-window:      "Windows";
    display-filebrowser: "Files";
    matching:            "fuzzy";
    sort:                true;
    sorting-method:      "fzf";
    kb-mode-next:        "Tab,Control+Tab";
    kb-mode-previous:    "ISO_Left_Tab,Control+ISO_Left_Tab";
    kb-element-next:     "";
    kb-element-prev:     "";
}

@theme "win95"
